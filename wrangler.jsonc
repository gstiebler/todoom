{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "todoom",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // Every preview deployment would otherwise get its own hostname. Those are
  // real origins serving the whole app, but no OAuth redirect URI is
  // registered for them, so sign-in is broken there anyway — a public surface
  // with no use.
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The app is a single-page app with no router, but a stray deep link
    // should still land on it rather than a 404.
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
