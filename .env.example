# Copy to .dev.vars for local development. In production these are Worker
# secrets (npx wrangler secret put ...), never committed and never sent to the
# browser.

# OAuth 2.0 "Web application" client from the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Encrypts the refresh token held in the session
# cookie; changing it signs every user out.
SESSION_SECRET=
